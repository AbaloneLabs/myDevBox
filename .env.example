# MyDevBox 환경 변수 예제
# 복사해서 .env로 사용: cp .env.example .env

# 서버 설정
NODE_ENV=development
PORT=35001
HOST=0.0.0.0

# 데이터베이스 (Docker Compose 사용 시 자동 설정)
DATABASE_URL=postgresql://mydevbox:mydevbox@localhost:35432/mydevbox

# 암호화 키 (git 토큰 등 민감 정보 암호화용, 프로덕션에서는 반드시 변경)
# 32바이트 (64 hex chars) 키 생성: openssl rand -hex 32
ENCRYPTION_KEY=mydevbox-dev-encryption-key-change-in-prod

# OAuth(PKCE — Anthropic/Codex) 콜백이 돌아올 공개 URL.
# 디바이스코드 프로바이저(Copilot/Kimi/xAI)에는 불필요.
# LAN에서 접근 시 서버 IP로 설정 (예: http://192.168.0.35:35001).
MYDEVBOX_PUBLIC_URL=http://localhost:35001
